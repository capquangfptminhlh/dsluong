---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Trang chủ" description="Chào mừng đến với hệ thống quản lý AutoTax POS.">
  <div class="text-center py-20">
    <h1 class="text-5xl font-extrabold text-blue-900 mb-6">Chào mừng đến với AutoTax POS</h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      Giải pháp quản lý bán hàng và thuế hộ kinh doanh tối ưu nhất hiện nay.
    </p>
    <a href="/blog" class="inline-block bg-blue-600 text-white font-bold py-3 px-8 rounded hover:bg-blue-700 transition-colors">
      Đọc Blog Kiến Thức
    </a>
  </div>
</BaseLayout>
