{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "entityId": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["Organization", "Person", "Product", "Service", "Place"] },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "officialUrls": { "type": "array", "items": { "type": "string" } },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factId": { "type": "string" },
          "key": { "type": "string" },
          "value": { "type": "string" },
          "sourceId": { "type": "string" },
          "effectiveDate": { "type": "string" }
        }
      }
    }
  },
  "required": ["entityId", "name", "type"]
}
